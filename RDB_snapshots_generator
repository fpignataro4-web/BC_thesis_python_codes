import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import os
import warnings

warnings.filterwarnings("ignore")

# =============================================================================
# 1. THEMATIC CONFIGURATION & BATCH SETUP
# =============================================================================
file_path = 'data_10_master_final.xlsx'

# Define academic color palettes mapping to respective substrates.
THEMES = {
    'tea': {
        'liquid': '#D35400', 'bc_fill': '#F39C12', 'bc_edge': '#B9770E', 'disc': '#6E2C00'
    },
    'pineapple': {
        'liquid': '#F4D03F', 'bc_fill': '#F9E79F', 'bc_edge': '#D4AC0D', 'disc': '#7D6608'
    },
    'blackberry': {
        'liquid': '#8E44AD', 'bc_fill': '#D2B4DE', 'bc_edge': '#7D3C98', 'disc': '#4A235A'
    },
    'default': {
        'liquid': '#3498DB', 'bc_fill': '#F1C40F', 'bc_edge': '#D4AC0D', 'disc': '#2C3E50'
    }
}

BATCH_CONFIG = {
    'Batch_1': 'tea', 'Batch_2': 'tea', 'Batch_3': 'blackberry',
    'Batch_4': 'tea', 'Batch_5': 'tea', 'Batch_6': 'pineapple', 'Batch_7': 'pineapple'
}

BATCH_LABELS = {
    'Batch_1': 'Control tea', 'Batch_2': 'Control tea', 'Batch_3': 'Blackberry wastes',
    'Batch_4': 'Low sugar tea', 'Batch_5': 'Low sugar tea', 
    'Batch_6': 'Pineapple juice', 'Batch_7': 'Pineapple juice'
}

output_dir = 'RDB_Storyboard_Plots'
os.makedirs(output_dir, exist_ok=True)

# =============================================================================
# 2. GEOMETRIC ENGINE (Rigorous Model with Effective Radius)
# =============================================================================
tank_L, tank_W, tank_H = 24.25, 16.0, 18.0      
axis_Z = 8.8
disc_radius, disc_width, disc_gap = 7.4, 0.3, 1.5
right_margin = tank_L - 1.5 
disc_centers_x = [right_margin - (disc_width / 2) - i*(disc_width + disc_gap) for i in range(8)]
r_array = np.linspace(0, disc_radius, 200)
y_array = np.linspace(axis_Z - disc_radius, axis_Z + disc_radius, 300)
r_y = np.abs(y_array - axis_Z) 

def get_volumes(lvl, T_r):
    """
    Integrates system volumes and rigorously calculates the submerged 
    disc fraction based on Effective Radius (Plastic + BC rim thickness).
    """
    # BC Total Volume Calculation
    V_bc_facce = 2 * np.trapz(2 * np.pi * r_array * T_r, r_array)
    T_rim = T_r[-1] if len(T_r) > 0 else 0.0
    V_bc_bordo = np.pi * ((disc_radius + T_rim)**2 - disc_radius**2) * disc_width
    V_bc_totale = (V_bc_facce + V_bc_bordo) * 8
    
    # Net Liquid Volume Calculation
    V_lordo = tank_W * tank_L * lvl
    h_rel = lvl - axis_Z
    r_safe = np.maximum(r_array, 1e-6)
    fraction_submerged_radial = np.arccos(np.clip(-h_rel / r_safe, -1.0, 1.0)) / np.pi 
    
    W_r_tot = disc_width + 2 * T_r
    V_solido_facce_sommerse = np.trapz(2 * np.pi * r_array * W_r_tot * fraction_submerged_radial, r_array)
    
    V_solido_bordo_tot = np.pi * ((disc_radius + T_rim)**2 - disc_radius**2) * disc_width
    fraction_rim = np.arccos(np.clip(-h_rel / disc_radius, -1.0, 1.0)) / np.pi
    V_solido_bordo_sommerso = V_solido_bordo_tot * fraction_rim
    
    V_solido_sommerso_totale = (V_solido_facce_sommerse + V_solido_bordo_sommerso) * 8
    V_liquido_netto = V_lordo - V_solido_sommerso_totale
    
    # *** RIGOROUS SUBMERGED FRACTION CALCULATION ***
    effective_radius = disc_radius + T_rim
    
    d_clipped = np.clip(lvl - axis_Z, -effective_radius, effective_radius)
    alpha = np.arccos(np.clip(-d_clipped / effective_radius, -1.0, 1.0))
    area_per_face = (effective_radius**2 * alpha) + (d_clipped * np.sqrt(np.maximum(0, effective_radius**2 - d_clipped**2)))
    
    total_effective_area = np.pi * effective_radius**2
    subm_fraction = area_per_face / total_effective_area
    
    return V_liquido_netto, V_bc_totale, subm_fraction

def get_bc_polygon(X_c, T_y):
    if np.max(T_y) < 0.01: return np.zeros((3,2))
    x_right = X_c + (disc_width / 2) + T_y
    x_left = X_c - (disc_width / 2) - T_y
    
    top_cap_r = (disc_width / 2) + T_y[-1]
    theta_top = np.linspace(0, np.pi, 30)
    x_top_cap, y_top_cap = X_c + top_cap_r * np.cos(theta_top), y_array[-1] + top_cap_r * np.sin(theta_top)
    
    bottom_cap_r = (disc_width / 2) + T_y[0]
    theta_bot = np.linspace(np.pi, 2*np.pi, 30)
    x_bot_cap, y_bot_cap = X_c + bottom_cap_r * np.cos(theta_bot), y_array[0] + bottom_cap_r * np.sin(theta_bot)
    
    x_poly = np.concatenate([x_right, x_top_cap, x_left[::-1], x_bot_cap])
    y_poly = np.concatenate([y_array, y_top_cap, y_array[::-1], y_bot_cap])
    return np.column_stack((x_poly, y_poly))

# =============================================================================
# 3. DATA INGESTION
# =============================================================================
try:
    df_full = pd.read_excel(file_path, sheet_name='time_series')
    df_full.columns = df_full.columns.str.strip()
except Exception as e:
    raise RuntimeError(f"Data loading failed: {e}")

# =============================================================================
# 4. STORYBOARD GENERATOR (0%, 33.3%, 66.6%, 100%)
# =============================================================================
target_fractions = [0.0, 0.333, 0.666, 1.0]
labels_fractions = ["0%", "33.3%", "66.6%", "100%"]

for batch_id, theme_name in BATCH_CONFIG.items():
    print(f"📸 Generating Rigorous 2x2 Storyboard for {batch_id}...")
    theme = THEMES.get(theme_name, THEMES['default'])
    batch_label = BATCH_LABELS.get(batch_id, theme_name.capitalize())
    
    df_b = df_full[df_full['Batch_id'] == batch_id].sort_values('Time_h').reset_index(drop=True)
    if df_b.empty: continue
        
    df_b['Time_h'] = pd.to_numeric(df_b['Time_h'], errors='coerce')
    df_b['Level_cm'] = pd.to_numeric(df_b['Level_cm'], errors='coerce')
    df_b['Cellulose_disks_thickness_mm_offline'] = pd.to_numeric(df_b['Cellulose_disks_thickness_mm_offline'], errors='coerce')
    
    df_clean = df_b.dropna(subset=['Time_h', 'Level_cm', 'Cellulose_disks_thickness_mm_offline'])
    if df_clean.empty: continue
        
    max_time = df_clean['Time_h'].max()
    num_frames = 200 
    time_interp = np.linspace(0, max_time, num_frames)
    level_interp = np.interp(time_interp, df_clean['Time_h'], df_clean['Level_cm'])
    thick_interp = np.interp(time_interp, df_clean['Time_h'], df_clean['Cellulose_disks_thickness_mm_offline'])
    
    Thk_matrix = np.zeros((num_frames, len(r_array)))
    for i in range(1, num_frames):
        dThk = max(0, (thick_interp[i] - thick_interp[i-1]) / 10.0)
        r_wet_threshold = axis_Z - level_interp[i]
        is_wet = r_array >= r_wet_threshold
        Thk_matrix[i] = Thk_matrix[i-1] + (dThk * is_wet)
        
    initial_lvl_h = level_interp[0]

    # --- Plotting the 2x2 Grid ---
    fig, axes = plt.subplots(2, 2, figsize=(16, 12))
    fig.patch.set_facecolor('white')
    fig.suptitle(f"Kinematic Evolution: {batch_id} - {batch_label}", fontsize=20, fontweight='bold', y=0.98)
    
    for idx, ax in enumerate(axes.flat):
        frame_idx = int(target_fractions[idx] * (num_frames - 1))
        t = time_interp[frame_idx]
        lvl = level_interp[frame_idx]
        T_r = Thk_matrix[frame_idx]
        T_y = np.interp(r_y, r_array, T_r)
        
        # Extract Rigorous Submerged Fraction from the geometric engine
        _, _, Subm_Frac = get_volumes(lvl, T_r)
        
        ax.set_facecolor('white') 
        ax.set_xlim(0, tank_L)
        ax.set_ylim(0, tank_H)
        ax.set_aspect('equal') 
        ax.axis('off')
        
        # Tank & Axis
        ax.plot([0, tank_L], [0, 0], color='#2C3E50', linewidth=5, zorder=6)
        ax.plot([0, 0], [0, tank_H], color='#2C3E50', linewidth=5, zorder=6)
        ax.plot([tank_L, tank_L], [0, tank_H], color='#2C3E50', linewidth=5, zorder=6)
        ax.plot([0, tank_L], [axis_Z, axis_Z], color='#7F8C8D', linewidth=3, linestyle='-.', zorder=1)
        ax.plot([0, tank_L], [initial_lvl_h, initial_lvl_h], color='#C0392B', linewidth=2, linestyle=':', zorder=7)
        
        # Liquid
        liquid_rect = patches.Rectangle((0, 0), tank_L, lvl, linewidth=0, facecolor=theme['liquid'], alpha=0.35, zorder=2)
        ax.add_patch(liquid_rect)
        ax.plot([0, tank_L], [lvl, lvl], color=theme['liquid'], linewidth=2, linestyle='--', zorder=3)
        
        # BC and Discs
        for cx in disc_centers_x:
            vertices = get_bc_polygon(cx, T_y)
            if len(vertices) > 3:
                bc_poly = patches.Polygon(vertices, linewidth=1.5, edgecolor=theme['bc_edge'], facecolor=theme['bc_fill'], alpha=0.75, zorder=4)
                ax.add_patch(bc_poly)
            disc_rect = patches.Rectangle((cx - disc_width/2, axis_Z - disc_radius), disc_width, disc_radius*2, linewidth=1, edgecolor='#17202A', facecolor=theme['disc'], alpha=0.9, zorder=5)
            ax.add_patch(disc_rect)
            
        # Updated Academic Title 
        ax.set_title(f"Time: {t:.1f} h ({labels_fractions[idx]}) | Level: {lvl:.2f} cm | Subm. Frac: {Subm_Frac * 100:.1f} %", 
                     fontsize=13, fontweight='bold', color='#2C3E50', pad=10)

    plt.tight_layout(rect=[0, 0, 1, 0.95])
    plot_path = os.path.join(output_dir, f"{batch_id}_Storyboard_model.png")
    plt.savefig(plot_path, dpi=300, bbox_inches='tight')
    plt.close()
    
print(f"\n🎉 DONE! High-Res Academic Storyboards with Rigorous Submerged Fractions generated in '{output_dir}'.")
